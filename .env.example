# MySQL (independent local service)
WEBBOX_DB_HOST=127.0.0.1
WEBBOX_DB_PORT=3306
WEBBOX_DB_NAME=webox
WEBBOX_DB_USERNAME=webox_app
WEBBOX_DB_PASSWORD=replace-with-your-local-password

# Required JWT signing secret. Generate a unique value with: openssl rand -base64 48
# Keep the generated value only in your ignored .env file; never commit it.
WEBBOX_JWT_SECRET=replace-with-a-private-secret-of-at-least-32-bytes

# Project-isolated Redis instance. Port 6379 belongs to another local project.
WEBBOX_REDIS_HOST=127.0.0.1
WEBBOX_REDIS_PORT=6380
